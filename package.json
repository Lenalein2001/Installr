{
  "name": "installr",
  "description": "Desktop Windows app installer manager",
  "author": "Lena",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "generate:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "build": "tsc -b && vite build --base ./",
    "build:desktop": "npm run generate:icon && npm run build && npm run package:desktop",
    "build:desktop:portable": "npm run generate:icon && npm run build && npm run package:desktop:portable",
    "build:desktop:folder": "npm run generate:icon && npm run build && node scripts/build-folder.cjs",
    "package:desktop": "node scripts/package-nsis.cjs",
    "package:desktop:portable": "electron-builder --win portable --publish never",
    "benchmark:inventory": "node scripts/benchmark-inventory.cjs",
    "test": "node --test",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^45.4.1",
    "electron-builder": "26.18.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.installr.desktop",
    "productName": "Installr",
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/installr.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false,
      "artifactName": "Installr-Setup-${version}.exe"
    }
  }
}
